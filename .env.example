# ============================================================
# KOVAE Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# MOBILE APP (apps/mobile/.env)
# These are the ONLY keys that belong in the mobile bundle.
# ────────────────────────────────────────────────────────────

# Supabase — public/anon key only (safe for client-side)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# API
EXPO_PUBLIC_API_URL=http://localhost:8000

# Analytics (PostHog)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_...your-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ────────────────────────────────────────────────────────────
# BACKEND (backend/.env)
# ⚠️  NEVER expose these in the mobile app or admin frontend.
# ────────────────────────────────────────────────────────────

# Database — local Docker or Supabase connection string
DATABASE_URL=postgresql+asyncpg://kovae:kovae_dev@localhost:5432/kovae

# Supabase — service role key (BACKEND ONLY — bypasses RLS)
# ⛔ NEVER put this in mobile or frontend code
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Gateway
AI_PRIMARY_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=

# Security
JWT_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────
# ADMIN DASHBOARD (apps/admin/.env.local)
# ────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
